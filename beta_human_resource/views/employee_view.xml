<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="hr_hr_employee_view_form_hide_badges" model="ir.ui.view">
            <field name="name">hr.hr.employee.view.form.hide.badges</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@string='Received Badges']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@string='Goals']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- Add group to bank_account_id -->
                <xpath expr="//field[@name='bank_account_id']" position="attributes">
                    <attribute name="groups">__export__.res_groups_252,__export__.res_groups_200</attribute>
                </xpath>

                <xpath expr="//field[@name='bank_account_id']" position="after">
                    <field name="salary_cert_issued" groups="__export__.res_groups_252,__export__.res_groups_200"/>
                </xpath>

                <!-- Add group to otherid -->
                <xpath expr="//field[@name='otherid']" position="attributes">
                    <attribute name="groups">__export__.res_groups_252,__export__.res_groups_200</attribute>
                </xpath>
            </field>
        </record>
        <record id="od_hr_employee_view_form_hide_pages" model="ir.ui.view">
            <field name="name">od.hr.employee.view.form.hide.pages</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="orchid_hrms.view_od_hrms_employee_inherit"/>
            <field name="arch" type="xml">
                <!-- Home Address: UAE company only -->
                <xpath expr="//group[@string='Home Address']" position="attributes">
                    <attribute name="attrs">{'invisible': [('company_id','!=',1)]}</attribute>
                    <attribute name="colspan">2</attribute>
                </xpath>


                <xpath expr="//page[@string='Emergency Contact']" position="replace">
                    <page string="Emergency Contacts">
                        <group>
                            <group string="Emergency Contact 1">
                                <field name="od_e_c1_name"/>
                                <field name="od_e_c1_relationship"/>
                                <field name="od_e_c1_city"/>
                                <field name="od_e_c1_ph1"/>
                            </group>
                            <group string="Emergency Contact 2">
                                <field name="od_e_c2_name"/>
                                <field name="od_e_c2_relationship"/>
                                <field name="od_e_c2_city"/>
                                <field name="od_e_c2_ph1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Medical Contact &amp; History">
                                <field name="od_mc_blood_group"/>
                                <field name="od_mc_allergies"/>
                            </group>
                            <group/>
                        </group>
                    </page>
                </xpath>

                <!-- National Address: Saudi company only -->
                <xpath expr="//group[@string='Home Address']" position="after">
                    <group string="National Address" colspan="2"
                           attrs="{'invisible': [('company_id','!=',6)]}">
                        <group>
                            <field name="short_addr" placeholder="e.g. RRRD2929"/>
                            <!-- add more fields here if you have them -->
                            <!-- <field name="building_no"/> -->
                            <!-- <field name="street_name"/> -->
                        </group>
                        <group>
                            <!-- <field name="district"/> -->
                            <!-- <field name="city_name"/> -->
                            <!-- <field name="post_code"/> -->
                        </group>
                    </group>
                </xpath>
                <xpath expr="//page[@string='Launguage']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@string='Entitlement']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@string='Dependents']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@string='Education']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@string='Beneficiary']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@string='Job Histroy']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group[@string='Air Route']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</openerp>


