<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="view_hr_payslip_form_salary_totals" model="ir.ui.view">
            <field name="name">hr.payslip.form.salary.totals</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Salary Totals" name="salary_totals" invisible="1">
                        <group>
                            <group>
                                <field name="normal_salary"/>
                                <field name="leave_salary"/>
                            </group>
                            <group>
                                <field name="ot_salary"/>
                                <field name="deduction"/>
                            </group>
                        </group>
                        <group>
                            <field name="total_salary"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</openerp>