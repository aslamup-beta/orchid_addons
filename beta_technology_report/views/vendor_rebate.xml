<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <!-- Form View -->
        <record id="view_vendor_rebate_form" model="ir.ui.view">
            <field name="name">vendor.rebate.form</field>
            <field name="model">vendor.rebate</field>
            <field name="arch" type="xml">
                <form string="Vendor Rebate">
                    <header>
                        <button name="action_submit" states="draft" string="Submit To Finance" type="object"
                                class="oe_highlight"/>
                        <button name="action_approve" states="pending" string="Approve" type="object"
                                class="oe_highlight" groups="account.group_account_user,account.group_account_manager"/>
                        <button name="action_create_invoice" string="Create Invoice" type="object"
                                class="oe_highlight" attrs="{'invisible': ['|',('invoice_id', '!=', False),('state', '!=', 'approved')]}"
                                groups="account.group_account_user,account.group_account_manager"/>
                        <button name="action_cancel" states="draft,pending" string="Cancel" type="object"/>
                        <button name="action_reset_draft" states="cancelled" string="Reset to Draft" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="customer_id" required="1"/>
                                <field name="vendor_id" required="1"/>
                                <field name="deal_reference"/>
                                <field name="deposit_within_months"/>
                                <field name="amount" required="1"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="od_cost_centre_id" attrs="{'required': [('state', '=', 'pending')],'invisible': [('state', '=', 'draft')]}"/>
                                <field name="od_branch_id" required="1"/>
                                <field name="od_division_id" required="1"/>
                                <field name="invoice_id" attrs="{'invisible': [('invoice_id', '=', False)]}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Terms &amp; Conditions">
                                <field name="description" placeholder="Add additional details..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_vendor_rebate_tree" model="ir.ui.view">
            <field name="name">vendor.rebate.tree</field>
            <field name="model">vendor.rebate</field>
            <field name="arch" type="xml">
                <tree string="Vendor Rebates">
                    <field name="name"/>
                    <field name="vendor_id"/>
                    <field name="customer_id"/>
                    <field name="amount"/>
                    <field name="date"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Action -->
        <record id="action_vendor_rebate" model="ir.actions.act_window">
            <field name="name">Vendor Rebate</field>
            <field name="res_model">vendor.rebate</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Menu item under Purchases -->
        <menuitem id="menu_vendor_rebate_main" name="Vendor Rebate" parent="orchid_cost_sheet.menu_cost_sheet_parent" sequence="20"
                  action="action_vendor_rebate" groups="__export__.res_groups_263,orchid_beta.group_executive_management_beta_1,orchid_beta.groups_beta_admin"/>

        <!-- Sequence for Auto-numbering -->
        <record model="ir.sequence.type" id="seq_type_vendor_rebate">
            <field name="name">Vendor Rebate</field>
            <field name="code">vendor.rebate</field>
        </record>

        <record id="seq_vendor_rebate" model="ir.sequence">
            <field name="name">Vendor Rebate</field>
            <field name="code">vendor.rebate</field>
            <field name="prefix">REB/</field>
            <field name="padding">5</field>
        </record>

    </data>
</openerp>