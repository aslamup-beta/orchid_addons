        </table>
        <table dir="ltr" style="direction:ltr;unicode-bidi:bidi-override;width:100%;border-collapse:separate;border-spacing:3px 0;" cellpadding="0" cellspacing="0">
            <tr>
                <td style="text-align:center;"><a href="${object.get_feedback_url(10)}" style="display:block;text-decoration:none;background-color:#6FCF5A;color:#222222;font-size:12px;font-weight:bold;padding:11px 0;border-radius:5px;">10</a></td>
                <td style="text-align:center;"><a href="${object.get_feedback_url(9)}" style="display:block;text-decoration:none;background-color:#8AD05A;color:#222222;font-size:12px;font-weight:bold;padding:11px 0;border-radius:5px;">9</a></td>
                <td style="text-align:center;"><a href="${object.get_feedback_url(8)}" style="display:block;text-decoration:none;background-color:#A5D15A;color:#222222;font-size:12px;font-weight:bold;padding:11px 0;border-radius:5px;">8</a></td>
                <td style="text-align:center;"><a href="${object.get_feedback_url(7)}" style="display:block;text-decoration:none;background-color:#C1D35A;color:#222222;font-size:12px;font-weight:bold;padding:11px 0;border-radius:5px;">7</a></td>
                <td style="text-align:center;"><a href="${object.get_feedback_url(6)}" style="display:block;text-decoration:none;background-color:#DCD45A;color:#222222;font-size:12px;font-weight:bold;padding:11px 0;border-radius:5px;">6</a></td>
                <td style="text-align:center;"><a href="${object.get_feedback_url(5)}" style="display:block;text-decoration:none;background-color:#F7D55A;color:#222222;font-size:12px;font-weight:bold;padding:11px 0;border-radius:5px;">5</a></td>
                <td style="text-align:center;"><a href="${object.get_feedback_url(4)}" style="display:block;text-decoration:none;background-color:#F5BC59;color:#222222;font-size:12px;font-weight:bold;padding:11px 0;border-radius:5px;">4</a></td>
                <td style="text-align:center;"><a href="${object.get_feedback_url(3)}" style="display:block;text-decoration:none;background-color:#F2A359;color:#222222;font-size:12px;font-weight:bold;padding:11px 0;border-radius:5px;">3</a></td>
                <td style="text-align:center;"><a href="${object.get_feedback_url(2)}" style="display:block;text-decoration:none;background-color:#F08958;color:#222222;font-size:12px;font-weight:bold;padding:11px 0;border-radius:5px;">2</a></td>
                <td style="text-align:center;"><a href="${object.get_feedback_url(1)}" style="display:block;text-decoration:none;background-color:#ED7058;color:#222222;font-size:12px;font-weight:bold;padding:11px 0;border-radius:5px;">1</a></td>
                <td style="text-align:center;"><a href="${object.get_feedback_url(0)}" style="display:block;text-decoration:none;background-color:#EB5757;color:#222222;font-size:12px;font-weight:bold;padding:11px 0;border-radius:5px;">0</a></td>
            </tr>
        </table>
    </div>

    <div style="padding:22px 22px 24px 22px;text-align:center;border-top:1px solid #eeeeee;">
        <div style="font-size:14px;font-weight:bold;color:#444444;margin-bottom:14px;">مع أطيب التحيات،</div>
        <div style="font-size:15px;font-weight:bold;color:#1E1E50;">Dar Beta Information Technology</div>
        <div style="font-size:12px;color:#999999;margin-top:4px;">فريق تجربة العملاء</div>
    </div>

    <div style="background-color:#F6C75A;background:linear-gradient(90deg,#6FCF5A,#F6C75A,#EB5757);height:6px;"></div>
</div>
]]></field>
        </record>

    </data>
</openerp>
