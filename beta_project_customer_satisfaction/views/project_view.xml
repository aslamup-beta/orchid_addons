<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <!--
            NOTE: inherits project.edit_project, the standard Project form
            view shipped with the `project` module in Odoo 8. If your
            instance customises that view, adjust the xpath expressions
            below to match your actual base view structure.
        -->
        <record id="view_project_form_feedback_inherit" model="ir.ui.view">
            <field name="name">project.project.form.feedback</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">

                <!-- Send-request button lives in the header and now opens
                     the From/To wizard (project.feedback.request.wizard)
                     instead of sending immediately. -->
                <xpath expr="//header" position="inside">
                    <button name="action_send_feedback_request"
                            type="object"
                            groups="__export__.res_groups_196,orchid_beta.groups_beta_admin"
                            string="Send Feedback Request" attrs="{'invisible': [('feedback_sent_to', '!=', False)]}"
                            class="oe_highlight"/>
                </xpath>

                <!-- Feedback tab: plain fields on the project itself, no
                     embedded list - a project only ever holds one current
                     rating/feedback/score. Plain (readonly) field for
                     `rating` here: with 10 options a radio widget gets
                     cluttered in the backend form. The customer-facing
                     0-10 gradient bar lives in the email and on the public
                     page (views/feedback_templates.xml,
                     data/email_template.xml). `score` is intentionally not
                     shown here (still computed/stored on the model - the
                     KPI page below still reads it via
                     cust_feedback_score - just hidden from this tab). -->
                <xpath expr="//notebook" position="inside">
                    <page string="Feedback" name="customer_feedback" groups="__export__.res_groups_196,orchid_beta.groups_beta_admin">
                        <group>
                            <group>
                                <field name="rating" readonly="1"/>
                            </group>
                            <group>
                                <field name="feedback_message" readonly="1"/>
                                <field name="feedback_sent_to" readonly="1"/>
                                <field name="feedback_language" readonly="1"/>
                            </group>
                        </group>
                        <group string="Comments">
                            <field name="feedback_text" nolabel="1"
                                   placeholder="No feedback submitted yet." readonly="1"/>
                        </group>
                    </page>

                    <page string="Project Compliance" >
    <div class="project_compliance_table" groups="__export__.res_groups_196,orchid_beta.groups_beta_admin,__export__.res_groups_265">
        <table style="width:100%; border-collapse:collapse; table-layout:fixed;">
            <thead>
                <tr style="background:#e6e6e6;">
                    <th style="width:5%; border:1px solid #c8c8c8; padding:8px; text-align:center; font-weight:bold;">No.</th>
                    <th style="width:30%; border:1px solid #c8c8c8; padding:8px; text-align:left; font-weight:bold;">Report / Document</th>
                    <th style="width:45%; border:1px solid #c8c8c8; padding:8px; text-align:left; font-weight:bold;">SharePoint Link for Evidence</th>
                    <th style="width:20%; border:1px solid #c8c8c8; padding:8px; text-align:center; font-weight:bold;">Status</th>
                </tr>
            </thead>
            <tbody>
                <!-- Row 1 -->
                <tr attrs="{'invisible': [('od_type_of_project', 'not in', ['imp', 'sup_imp'])]}">
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center;">1</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle;">Kick-Off Meeting Minutes (KOM MOM)</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere;">
                        <field name="compliance_link_1" widget="url" nolabel="1"/>
                    </td>
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center; vertical-align:middle;">
                        <field name="compliance_status_1" nolabel="1"/>
                    </td>
                </tr>

                <!-- Row 2 -->
                <tr attrs="{'invisible': [('od_type_of_project', 'not in', ['imp', 'sup_imp'])]}">
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center;">2</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle;">Progress / Weekly Meeting Minutes (MOM)</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere;">
                        <field name="compliance_link_2" widget="url" nolabel="1"/>
                    </td>
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center; vertical-align:middle;">
                        <field name="compliance_status_2" nolabel="1"/>
                    </td>
                </tr>

                <!-- Row 3 -->
                <tr attrs="{'invisible': [('od_type_of_project', 'not in', ['imp', 'sup_imp'])]}">
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center;">3</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle;">Kickoff Meeting</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere;">
                        <field name="compliance_link_3" widget="url" nolabel="1"/>
                    </td>
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center; vertical-align:middle;">
                        <field name="compliance_status_3" nolabel="1"/>
                    </td>
                </tr>

                <!-- Row 4 -->
                <tr attrs="{'invisible': [('od_type_of_project', 'not in', ['imp', 'sup_imp'])]}">
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center;">4</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle;">Weekly Status Report</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere;">
                        <field name="compliance_link_4" widget="url" nolabel="1"/>
                    </td>
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center; vertical-align:middle;">
                        <field name="compliance_status_4" nolabel="1"/>
                    </td>
                </tr>

                <!-- Row 5 -->
                <tr attrs="{'invisible': [('od_type_of_project', 'not in', ['imp', 'sup_imp'])]}">
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center;">5</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle;">Updated Schedule Plan</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere;">
                        <field name="compliance_link_5" widget="url" nolabel="1"/>
                    </td>
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center; vertical-align:middle;">
                        <field name="compliance_status_5" nolabel="1"/>
                    </td>
                </tr>

                <!-- Row 6 -->
                <tr attrs="{'invisible': [('od_type_of_project', 'not in', ['imp', 'sup_imp'])]}">
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center;">6</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle;">Design Document (HLD, LLD, migration plan, connectivity matrix)</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere;">
                        <field name="compliance_link_6" widget="url" nolabel="1"/>
                    </td>
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center; vertical-align:middle;">
                        <field name="compliance_status_6" nolabel="1"/>
                    </td>
                </tr>

                <!-- Row 7 -->
                <tr attrs="{'invisible': [('od_type_of_project', 'not in', ['imp', 'sup_imp'])]}">
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center;">7</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle;">JCC (PS)</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere;">
                        <field name="compliance_link_7" widget="url" nolabel="1"/>
                    </td>
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center; vertical-align:middle;">
                        <field name="compliance_status_7" nolabel="1"/>
                    </td>
                </tr>

                <!-- Row 8 -->
                <tr attrs="{'invisible': [('od_type_of_project', 'not in', ['sup','imp', 'sup_imp'])]}">
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center;">8</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle;">DN (MAT)</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere;">
                        <field name="compliance_link_8" widget="url" nolabel="1"/>
                    </td>
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center; vertical-align:middle;">
                        <field name="compliance_status_8" nolabel="1"/>
                    </td>
                </tr>

                <!-- Row 9 -->
                <tr attrs="{'invisible': [('od_type_of_project', 'not in', ['amc',])]}">
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center;">1</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle;">JCC (AMC)</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere;">
                        <field name="compliance_link_9" widget="url" nolabel="1"/>
                    </td>
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center; vertical-align:middle;">
                        <field name="compliance_status_9" nolabel="1"/>
                    </td>
                </tr>

                <!-- Row 10 -->
                <tr attrs="{'invisible': [('od_type_of_project', 'not in', ['o_m',])]}">
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center;">1</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle;">Timesheets (O&amp;M)</td>
                    <td style="border:1px solid #d5d5d5; padding:8px; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere;">
                        <field name="compliance_link_10" widget="url" nolabel="1"/>
                    </td>
                    <td style="border:1px solid #d5d5d5; padding:8px; text-align:center; vertical-align:middle;">
                        <field name="compliance_status_10" nolabel="1"/>
                    </td>
                </tr>

            </tbody>
        </table>
    </div>
</page>


                </xpath>
            </field>
        </record>

        <record id="view_project_form_inherit_kpi_cust_feedback" model="ir.ui.view">
            <field name="name">project.project.form.kpi.cust.feedback</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="orchid_beta_project.view_project_project_form_od_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@string='Post Project Evaluation - KPI']//tr[td/strong='Total Score']"
                       position="before">
                    <tr groups="__export__.res_groups_196,orchid_beta.groups_beta_admin">
                        <td>Customer Feedback</td>
                        <td>
                            <field name="cust_feedback_score"/>
                        </td>
                    </tr>
                </xpath>
            </field>
        </record>


    </data>
</openerp>
